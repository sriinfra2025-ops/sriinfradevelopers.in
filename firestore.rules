rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Venture photos collection: publicly readable by all customers, writable by admins/authenticated users
    match /venture_photos/{photoId} {
      allow read: if true;
      allow write: if true;
    }

    // Default rule for other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
